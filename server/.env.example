PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-secret

# Optional. Without this, VELORA still works using an in-memory demo database.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/velora

# Change these before a public production deployment.
ADMIN_EMAIL=admin@velora.demo
ADMIN_PASSWORD=VeloraAdmin123!

# Optional Stripe TEST MODE. Leave blank to use the built-in demo-card checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
